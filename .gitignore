# Reference material stays local. The capture holds another site's code, fonts
# and images, which must not be published; the saved model inputs are gigabytes.
reference/

# Licensed or secret data
*.env
.env*
fes2022/
tide-constants/

# Python
__pycache__/
*.pyc
.venv/
venv/

# Node / Astro
node_modules/
dist/
.astro/

# Design mockup sessions
.superpowers/

# Pipeline working files
data/
_tmp/
*.egg-info/

# Web build and generated data
web/node_modules/
web/dist/
web/.astro/
web/public/wx/
web/public/assets/globe/
web/test-results/
web/playwright-report/

# EOT20 tide atlas download (CC BY 4.0, 2 GB; fetched by the tide atlas tool)
eot20/

# Station catalogue inputs (NOAA, GeoNames, Natural Earth) and output
catalogue-inputs/
catalogue-out/
web/public/catalogue/
web/public/tides/
web/station-data/

# NOAA per-station responses and built tide files (rebuilt by the workflows)
noaa-cache/
tide-out/
sky-cache/
