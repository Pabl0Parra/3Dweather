---
// Header station search: a button that opens a panel with a combobox; the catalogue loads on first open.
// `prefix` keeps ids unique when a page has two boxes (the home page's hero).
interface Props { prefix?: string }
const { prefix = "station" } = Astro.props;
const panel = prefix === "station" ? "search-panel" : `${prefix}-search-panel`;
---
<div class="search" data-search>
  <button type="button" class="units-button search-button" aria-expanded="false" aria-controls={panel}>Search</button>
  <div class="search-panel" id={panel} hidden>
    <label class="search-label" for={`${prefix}-search`}>Search tide stations and places</label>
    <input id={`${prefix}-search`} class="search-input" type="search" role="combobox" aria-expanded="false"
      aria-autocomplete="list" aria-controls={`${prefix}-results`} autocomplete="off" spellcheck="false"
      placeholder="Town, harbour or gauge" />
    <ul id={`${prefix}-results`} class="search-results" role="listbox" aria-label="Stations"></ul>
    <p class="search-status" aria-live="polite"></p>
  </div>
</div>
<script>
  import { mountSearchBox } from "../search/box";
  document.querySelectorAll<HTMLElement>("[data-search]").forEach((el) => mountSearchBox(el));
</script>
