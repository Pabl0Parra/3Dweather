---
// The finder: every place on a map (clustered), and every country by continent.
import SiteLayout from "../components/SiteLayout.astro";
import { CONTINENTS, loadCountries } from "../stations/browse";

const countries = loadCountries();
const groups = Object.entries(CONTINENTS)
  .map(([code, name]) => ({ name, list: countries.filter((c) => c.continent === code).sort((a, b) => a.name.localeCompare(b.name, "en")) }))
  .filter((g) => g.list.length);
const total = countries.reduce((a, c) => a + c.count, 0);
---
<SiteLayout title="All tide stations and coastal places · 3Dweather" path="/stations" nav="tides"
  description="Find tide times for any coastal place on the map, or browse by country.">
  <h1>All places</h1>
  <p class="lede">{total ? `${total.toLocaleString("en")} tide stations and coastal places in ${countries.length} countries.` : "Tide stations and coastal places worldwide."} Zoom in on the map or pick a country.</p>
  <div class="finder-map" data-finder role="region" aria-label="Map of places"></div>
  {groups.map((g) => (
    <section>
      <h2>{g.name}</h2>
      <ul class="plain-list">
        {g.list.map((c) => <li><a href={`/${c.cc.toLowerCase()}`}>{c.name}</a> <span class="tag">{c.count}</span></li>)}
      </ul>
    </section>
  ))}
</SiteLayout>
<script>
  import { mountFinder } from "../finder/map";
  const el = document.querySelector<HTMLElement>("[data-finder]");
  if (el) mountFinder(el);
</script>
