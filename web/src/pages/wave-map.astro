---
import "../styles/globe.css";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Wave map · 3Dweather</title>
    <meta name="description" content="Forecast wave height for the next seven days on an interactive 3D globe." />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/wave-map">3Dweather</a>
      <div class="header-tools">
        <button type="button" class="units-button" id="units-button">Units</button>
      </div>
    </header>
    <main class="wave-page">
      <section class="globe" id="globe" aria-label="Interactive globe showing forecast wave height"></section>
      <div class="controls">
        <div id="timeline"></div>
        <button type="button" class="biggest-button" id="biggest-button">Biggest waves</button>
        <div id="legend"></div>
      </div>
      <noscript><p class="credits">The wave map needs JavaScript and WebGL.</p></noscript>
      <p class="credits">
        Waves: NOAA GFS-Wave via <a href="https://open-meteo.com/">Open-Meteo.com</a> (CC BY 4.0) · Coastlines: Natural Earth
      </p>
    </main>
    <script>
      import { initGlobe } from "../globe/globe";
      initGlobe(document.getElementById("globe")!, {
        timeline: document.getElementById("timeline")!,
        legend: document.getElementById("legend")!,
        unitsButton: document.getElementById("units-button") as HTMLButtonElement,
        biggestButton: document.getElementById("biggest-button") as HTMLButtonElement,
      });
    </script>
  </body>
</html>
