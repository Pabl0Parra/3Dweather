---
import "../styles/globe.css";
import "../styles/splash.css";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Wave map · 3Dweather</title>
    <meta name="description" content="Forecast wave height for the next seven days on an interactive 3D globe." />
    <script is:inline>
      // Hide the page chrome before first paint when the opening splash will play.
      try {
        if (!/[?&]nosplash/.test(location.search) && sessionStorage.getItem("3dw.splash") !== "1")
          document.documentElement.classList.add("splash-pending");
      } catch (e) {
        document.documentElement.classList.add("splash-pending");
      }
    </script>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/wave-map">3Dweather</a>
      <div class="header-tools">
        <button type="button" class="units-button" id="units-button">Units</button>
      </div>
    </header>
    <main class="wave-page">
      <section class="globe" id="globe" aria-label="Interactive globe showing forecast wave height"></section>
      <div class="controls">
        <div id="timeline"></div>
        <button type="button" class="biggest-button" id="biggest-button">Biggest waves</button>
        <div id="legend"></div>
      </div>
      <noscript><p class="credits">The wave map needs JavaScript and WebGL.</p></noscript>
      <p class="credits">
        Waves: NOAA GFS-Wave via <a href="https://open-meteo.com/">Open-Meteo.com</a> (CC BY 4.0) · Coastlines: Natural Earth
      </p>
    </main>
    <script>
      import { initGlobe } from "../globe/globe";
      import { markPlayed, shouldPlay } from "../splash/intro";
      import { playSplash } from "../splash/splash";

      const session = (() => { try { return window.sessionStorage; } catch { return null; } })();
      const play = shouldPlay(location.search, session);
      initGlobe(document.getElementById("globe")!, {
        timeline: document.getElementById("timeline")!,
        legend: document.getElementById("legend")!,
        unitsButton: document.getElementById("units-button") as HTMLButtonElement,
        biggestButton: document.getElementById("biggest-button") as HTMLButtonElement,
      }).then((globe) => {
        if (!globe || !play) {
          document.documentElement.classList.remove("splash-pending");
          return;
        }
        markPlayed(session);
        const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        void playSplash(globe, { reduced, dataReady: globe.loaded });
      });
    </script>
  </body>
</html>
